---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — donjuan Cartagena" description="La página que buscas no existe. Vuelve al inicio." currentPage="index" lang="es">
  <section class="min-h-screen flex items-center justify-center bg-stone-950">
    <div class="text-center max-w-lg mx-auto px-6">
      <span class="text-8xl md:text-9xl font-serif text-gold-500 block mb-4">404</span>
      <h1 class="text-2xl md:text-3xl font-serif text-white font-light mb-4">Página no encontrada</h1>
      <p class="text-stone-400 font-sans text-sm mb-8">La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="inline-flex items-center gap-2 px-8 py-4 border border-gold-500 text-gold-400 hover:bg-gold-500 hover:text-stone-950 font-sans text-xs uppercase tracking-widest transition-all duration-300">
        Volver al Inicio
      </a>
    </div>
  </section>
</Layout>
