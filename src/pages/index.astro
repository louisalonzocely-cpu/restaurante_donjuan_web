---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout currentPage="index" canonical="https://restaurante-donjuan-web.pages.dev/">

    <Header lang="es" currentPage="index" />

    <!-- Hero / Landing Section -->
    <section id="inicio" class="relative h-screen w-full overflow-hidden flex items-start justify-center">
        <!-- Carousel Background -->
        <div id="hero-carousel" class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-[#041118]/85 via-[#041118]/65 to-[#041118] z-10"></div>
            
            <!-- Slides -->
            <div class="carousel-slide active">
                <img src="/images/banner-home.webp" alt="Plato estrella del Restaurante Donjuán" class="w-full animate-subtle-zoom" fetchpriority="high" width="1920" height="1080" />
            </div>
            <div class="carousel-slide">
                <img loading="lazy" src="/images/banner-pulpo.webp" alt="Pulpo a la brasa" width="1920" height="1080" class="w-full animate-subtle-zoom" />
            </div>
            <div class="carousel-slide">
                <img loading="lazy" src="/images/robalo-parrilla.webp" alt="Robalo a la parrilla" width="1920" height="1080" class="w-full animate-subtle-zoom" />
            </div>

            <!-- Dots -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
                <button class="carousel-dot active w-2.5 h-2.5 rounded-full bg-white/80 hover:bg-white transition-all duration-300" data-index="0" aria-label="Slide 1"></button>
                <button class="carousel-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300" data-index="1" aria-label="Slide 2"></button>
                <button class="carousel-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300" data-index="2" aria-label="Slide 3"></button>
            </div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-36 md:pt-48">
            <!-- Sello decorativo -->
            <img loading="lazy" src="/images/sello-donjuan.webp" alt="Sello Donjuán" width="192" height="64" class="w-36 md:w-48 mx-auto -mt-8 mb-2 md:mb-3 animate-fade-in opacity-0 brightness-0 invert blur-[0.5px]" style="animation-delay: 0.3s" />

            <!-- Main Title -->
            <h1 class="text-7xl md:text-[10rem] lg:text-[13rem] font-['Cormorant',serif] text-white-pure font-light tracking-wide mb-6 md:mb-8 animate-slide-up opacity-0" style="animation-delay: 0.6s">
                <span class="sr-only">Restaurante Donjuán Cartagena</span>
                don<span class="text-emerald-400 italic">juan</span>
            </h1>
            
            <!-- Description -->
            <p class="text-base md:text-lg lg:text-xl font-sans text-gray-200 max-w-2xl mx-auto font-light leading-relaxed mb-8 md:mb-12 animate-slide-up opacity-0" style="animation-delay: 0.9s">
                Cocina de autor con alma contemporánea, inspirada en la exuberancia de los ingredientes locales del Caribe colombiano.
            </p>
            
            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-slide-up opacity-0" style="animation-delay: 1.2s">
                <a href="#reservas" class="w-full sm:w-auto px-8 py-4 bg-emerald-500 hover:bg-[#ADDE9E] text-white-pure font-sans text-xs uppercase tracking-widest font-bold transition-all duration-300 shadow-lg shadow-emerald-700/10 hover:shadow-xl hover:shadow-[#10b981]/30 hover:scale-105">
                    Reservar Mesa
                </a>
                <a href="/menu" class="w-full sm:w-auto px-8 py-4 border border-stone-500 hover:border-gold-400 text-white-pure hover:text-gold-400 font-sans text-xs uppercase tracking-widest font-medium transition-all duration-300 backdrop-blur-sm">
                    Explorar Menú
                </a>
            </div>


        </div>
    </section>

    <!-- History / Philosophy Section -->
    <section id="historia" class="py-24 md:py-32 relative overflow-hidden bg-stone-925">
        <div class="absolute -left-6 top-0 -bottom-4 z-0 pointer-events-none hidden md:flex">
            <img id="peces-bg" src="/images/peces.webp" alt="" class="max-h-full w-auto self-stretch animate-float" style="opacity: 0.06;" />
        </div>
        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
            <!-- Section Header -->
            <div class="text-center mb-16 md:mb-24">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-500 block mb-3 font-sans">Nuestra Filosofía</span>
                <h2 class="text-3xl md:text-5xl font-serif text-white font-light tracking-wide">El Alma detrás de los Fogones</h2>
                <div class="w-16 h-[1px] bg-gold-500 mx-auto mt-6"></div>
            </div>

            <!-- Editorial Layout Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                
                <!-- Col 1: Main Image -->
                <div class="lg:col-span-6 relative flex justify-center">
                    <div class="relative bg-white p-2 pb-8 shadow-xl shadow-black/30 rotate-[0.5deg] max-w-xs w-full">
                        <div class="relative overflow-hidden group">
                            <img loading="lazy" src="/images/juanf.webp" alt="Chef Juan Felipe Camacho" class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105 sepia-[0.15] contrast-[1.1] brightness-95" />
                            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/40 via-transparent to-stone-950/20 pointer-events-none"></div>
                        </div>
                        <div class="absolute bottom-2 left-1/2 -translate-x-1/2 bg-stone-950/80 backdrop-blur-sm border border-gold-500/20 px-4 py-2 whitespace-nowrap">
                            <p class="text-xs font-serif text-gold-400">Juan Felipe Camacho — <span class="italic text-stone-300">Chef & Fundador</span></p>
                        </div>
                    </div>
                </div>

                <!-- Col 2: Narrative Text -->
                <div class="lg:col-span-6 flex flex-col gap-8 lg:pl-6">
                    <p class="text-stone-400 text-xs uppercase tracking-widest font-sans">Desde 2009</p>
                    <h3 class="text-2xl md:text-4xl font-serif text-gold-400 font-light leading-tight">Un tributo honesto a los productores locales y la pesca artesanal</h3>
                    
                    <div class="h-[1px] w-full bg-gradient-to-r from-gold-500/30 to-transparent"></div>
                    
                    <div class="flex flex-col gap-6 text-stone-300 font-light leading-relaxed text-sm md:text-base">
                        <p>
                            Donjuán es el resultado de años de pasión de <strong class="text-white font-medium">Juan Felipe Camacho</strong>. Desde su llegada a Cartagena en 2005, se dedicó a recorrer el Caribe para buscar pescadores artesanales, cultivos de sustitución y pequeños productores locales para que su concepto gastronómico estuviera completo.
                        </p>
                        <p>
                            Nuestra cocina destaca por el absoluto respeto al producto. Los pescados y mariscos más frescos del litoral caribeño, las carnes colombianas seleccionadas y la inigualable oferta de vegetales de nuestro país se fusionan para crear platos casuales pero sofisticados, logrando combinaciones sencillas pero memorables.
                        </p>
                        <p>
                            Tras dos años de pausa, reabrimos nuestras puertas en el corazón del "corralito de piedra", en una casona histórica bellamente restaurada para continuar escribiendo la historia moderna de Cartagena a través del sabor.
                        </p>
                    </div>

                    <!-- Quote Block -->
                    <div class="border-l-2 border-gold-500 pl-6 py-2 my-2 italic text-stone-400 font-serif text-lg leading-relaxed">
                        "Buscamos la sofisticación a través de la sencillez y la frescura del ingrediente local."
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Exquisite Highlight Menu -->
    <section id="carta" class="py-12 md:py-20 relative overflow-hidden bg-stone-950 scroll-mt-20 bg-fixed bg-cover bg-center" style="background-image: url('/images/fondo-historia.webp');">
        <div class="absolute inset-0 bg-stone-950/85 z-0"></div>
        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
            <!-- Section Header -->
            <div class="text-center mb-8 md:mb-14">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-500 block mb-3 font-sans">Selección de Autor</span>
                <h2 class="text-3xl md:text-5xl font-serif text-white font-light tracking-wide">La Carta donjuan</h2>
                <p class="text-stone-400 font-sans text-sm mt-4 max-w-xl mx-auto">Una muestra representativa de nuestras creaciones culinarias más aclamadas.</p>
                <div class="w-16 h-[1px] bg-gold-500 mx-auto mt-6"></div>
            </div>

            <!-- Custom Category Tabs -->
            <div class="flex justify-center mb-6 md:mb-12">
                <div class="inline-flex gap-1 md:gap-8 overflow-x-auto pb-2 md:pb-4 max-w-full scrollbar-hide">
                <button data-tab="tab-entradas" id="btn-tab-entradas" class="menu-tab-btn active px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-gold-500 text-gold-400 font-medium whitespace-nowrap transition-all duration-300">
                    Entradas
                </button>
                <button data-tab="tab-fuertes" id="btn-tab-fuertes" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Platos Fuertes
                </button>
                <button data-tab="tab-postres" id="btn-tab-postres" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Postres
                </button>
                <button data-tab="tab-cocteles" id="btn-tab-cocteles" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Coctelería
                </button>
                </div>
            </div>

            <!-- Tab Contents -->
            <div class="relative">
                
                <!-- Category 1: Entradas -->
                <div id="tab-entradas" class="menu-category-panel grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-100 scale-100">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/crudo_robalo.webp" alt="Crudo de robalo" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Crudo del Día</h3>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$51.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Ají amarillo, rocoto, pomelo fresco.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-gold-500/10 text-gold-400 px-2 py-0.5 rounded">Recomendado</span>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/tartar-res.webp" alt="Tartar de Res" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Tartar de Res</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$53.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Acompañado de tapioca crujiente y una mayonesa suave de trufa de la casa.</p>
                        </div>
                    </div>
                    <!-- Item 3 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <img loading="lazy" src="/images/tataki-res.webp" alt="Tataki de Res a la Parrilla" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Tataki de Res a la Parrilla</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$49.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Teriyaki artesanal de panela, suero costeño tradicional y aceite de oliva extra virgen.</p>
                        </div>
                    </div>
                    <!-- Item 4 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <img loading="lazy" src="/images/ensalada-papaya.webp" alt="Ensalada de Papaya" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Ensalada de Papaya Verde</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$51.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Vinagreta de tamarindo, maní tostado y noodles crujientes. Una explosión de frescura.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded">Vegetariano</span>
                        </div>
                    </div>
                </div>

                <!-- Category 2: Fuertes -->
                <div id="tab-fuertes" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/robalo-parrilla.webp" alt="Róbalo a la parrilla" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Róbalo a la Parrilla</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$82.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Acompañado de un sedoso risotto de limón, queso parmesano y tomates confitados.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-gold-500/10 text-gold-400 px-2 py-0.5 rounded">Plato Estrella</span>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/robalo.webp" alt="Róbalo asado" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Róbalo Asado</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$81.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Tabbouleh de cebada, crema de berenjenas.</p>
                        </div>
                    </div>
                    <!-- Item 3 -->
                    <div class="flex flex-row gap-3 sm:gap-4 itms-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Ribeye Angus Beef</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$199.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Corte premium a la parrilla, aderezado con mostaza antigua y de tapioca crujiente.</p>
                        </div>
                    </div>
                    <!-- Item 4 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M19 12a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Corvina en Cayeye</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$83.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Servida sobre puré de plátano verde (cayeye), salsa cremosa de camarones y leche de coco.</p>
                        </div>
                    </div>
                </div>

                <!-- Category 3: Postres -->
                <div id="tab-postres" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/cubos-de-piña.webp" alt="Cubos de piña" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Cubos de Piña al Ron</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$32.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Con reducción de ron local, leche de coco, helado artesanal de coco y suero dulce costeño.</p>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Tarta de Manzana y Arequipe</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$34.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Servida tibia, con helado artesanal de vainilla Bourbon y lluvia de nuez de macadamia.</p>
                        </div>
                    </div>
                </div>

                <!-- Category 4: Cocteles -->
                <div id="tab-cocteles" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/beso-latino.webp" alt="Beso Latino" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Beso Latino</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$48.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Cóctel de autor con mezcal Ojo de Tigre premium, arándanos macerados, crema de coco natural y jugo de limón.</p>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img loading="lazy" src="/images/Don-Juan-Restaurant-Cocteles.webp" alt="Coctelería de autor" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Cosmo de Corozo</h4>
