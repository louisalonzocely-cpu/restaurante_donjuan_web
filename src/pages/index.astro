    <button id="back-to-top" class="fixed bottom-6 left-6 z-40 bg-stone-900/80 hover:bg-gold-500 text-stone-400 hover:text-stone-950 w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 opacity-0 pointer-events-none hover:scale-110 group" aria-label="Volver arriba">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
        </svg>
        <span class="absolute left-full ml-3 whitespace-nowrap text-xs font-sans bg-stone-900/90 text-stone-200 px-3 py-1.5 rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
            Subir
        </span>
    </button>

    <!-- Hero Carousel Styles -->
    <style>
        .carousel-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
            z-index: 0;
        }
        .carousel-slide.active {
            opacity: 1;
            z-index: 1;
        }
        .carousel-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .flip-card {
            cursor: pointer;
        }
        .flip-card-inner {
            position: relative;
        }

        .gallery-auto-accordion .accordion-content {
            overflow: hidden;
            transition: max-height 0.5s ease;
        }
        .gallery-hidden {
            display: none !important;
        }

    </style>

    <!-- Popup de prueba -->

    <style is:global>
        .whatsapp-btn {
            animation: whatsapp-glow 2s ease-in-out infinite;
        }
        @keyframes whatsapp-glow {
            0%, 100% {
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1), 0 0 6px 2px rgba(37, 211, 102, 0.3);
            }
            50% {
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1), 0 0 22px 8px rgba(37, 211, 102, 0.5);
            }
        }
    </style>
    <div id="popup-overlay" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 transition-opacity duration-300" style="opacity: 0; pointer-events: none;">
        <div class="bg-stone-900 border border-gold-500/20 max-w-md w-full mx-4 p-8 relative rounded-lg shadow-2xl transition-transform duration-300 scale-100" id="popup-card">
            <button id="popup-close" class="absolute top-3 right-4 text-stone-400 hover:text-white text-3xl leading-none">&times;</button>
            <h3 class="font-serif text-2xl text-white mb-2">¡Mejoramos nuestro sitio!</h3>
            <p class="text-stone-400 text-sm leading-relaxed mb-6">Esto es un popup de prueba. Podemos usarlo para promociones, avisos o lo que necesites.</p>
            <button id="popup-close-btn" class="bg-gold-500 text-stone-950 px-6 py-2 rounded text-sm uppercase tracking-widest font-semibold hover:bg-gold-400 transition-colors">Cerrar</button>
        </div>
    </div>

    <script>
      import '../scripts/main.js';
    </script>
</Layout>
