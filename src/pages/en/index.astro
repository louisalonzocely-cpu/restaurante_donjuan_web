---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout currentPage="index" lang="en" title="Donjuán Cartagena — Exclusive Redesign" description="Redesign of Restaurante Donjuán in the historic center of Cartagena. Signature cuisine with a contemporary soul." canonical="https://restaurante-donjuan-web.pages.dev/en">

    <Header lang="en" currentPage="index" />

    <!-- Hero / Landing Section -->
    <section id="inicio" class="relative h-screen w-full overflow-hidden flex items-start justify-center">
        <!-- Carousel Background -->
        <div id="hero-carousel" class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-[#041118]/85 via-[#041118]/65 to-[#041118] z-10"></div>
            
            <!-- Slides -->
            <div class="carousel-slide active">
                <img src="/images/banner-home.webp" alt="Signature dish of Restaurante Donjuán" class="w-full h-full object-cover animate-subtle-zoom" fetchpriority="high" width="1920" height="1080" />
            </div>
            <div class="carousel-slide">
                <img src="/images/banner-pulpo.webp" alt="Grilled octopus" width="1920" height="1080" class="w-full h-full object-cover animate-subtle-zoom" />
            </div>
            <div class="carousel-slide">
                <img src="/images/robalo-parrilla.webp" alt="Grilled sea bass" width="1920" height="1080" class="w-full h-full object-cover animate-subtle-zoom" />
            </div>

            <!-- Dots -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
                <button class="carousel-dot active w-2.5 h-2.5 rounded-full bg-white/80 hover:bg-white transition-all duration-300" data-index="0" aria-label="Slide 1"></button>
                <button class="carousel-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300" data-index="1" aria-label="Slide 2"></button>
                <button class="carousel-dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300" data-index="2" aria-label="Slide 3"></button>
            </div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-36 md:pt-48">
            <!-- Sello decorativo -->
            <img src="/images/sello-donjuan.webp" alt="Donjuán seal" width="192" height="64" class="w-36 md:w-48 mx-auto -mt-8 mb-2 md:mb-3 animate-fade-in opacity-0 brightness-0 invert blur-[0.5px]" style="animation-delay: 0.3s" />

            <!-- Main Title -->
            <h1 class="text-7xl md:text-[10rem] lg:text-[13rem] font-['Cormorant',serif] text-white-pure font-light tracking-wide mb-6 md:mb-8 animate-slide-up opacity-0" style="animation-delay: 0.6s">
                don<span class="text-emerald-500 italic">juan</span>
            </h1>
            
            <!-- Description -->
            <p class="text-base md:text-lg lg:text-xl font-sans text-gray-200 max-w-2xl mx-auto font-light leading-relaxed mb-8 md:mb-12 animate-slide-up opacity-0" style="animation-delay: 0.9s">
                Author cuisine with a contemporary soul, inspired by the exuberance of local ingredients from the Colombian Caribbean.
            </p>
            
            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-slide-up opacity-0" style="animation-delay: 1.2s">
                <a href="/en/#reservas" class="w-full sm:w-auto px-8 py-4 bg-emerald-700 hover:bg-emerald-600 text-white-pure font-sans text-xs uppercase tracking-widest font-bold transition-all duration-300 shadow-lg shadow-emerald-700/10">
                    Book a Table
                </a>
                <a href="/en/menu" class="w-full sm:w-auto px-8 py-4 border border-stone-500 hover:border-gold-400 text-white-pure hover:text-gold-400 font-sans text-xs uppercase tracking-widest font-medium transition-all duration-300 backdrop-blur-sm">
                    Explore Menu
                </a>
            </div>


        </div>
    </section>

    <!-- History / Philosophy Section -->
    <section id="historia" class="py-24 md:py-32 relative overflow-hidden bg-stone-925">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <!-- Section Header -->
            <div class="text-center mb-16 md:mb-24">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-500 block mb-3 font-sans">Our Philosophy</span>
                <h2 class="text-3xl md:text-5xl font-serif text-white font-light tracking-wide">The Soul Behind the Kitchen</h2>
                <div class="w-16 h-[1px] bg-gold-500 mx-auto mt-6"></div>
            </div>

            <!-- Editorial Layout Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                
                <!-- Col 1: Main Image -->
                <div class="lg:col-span-6 relative flex justify-center">
                    <div class="relative overflow-hidden border border-gold-500/10 group max-w-xs w-full">
                        <img src="/images/juanf.webp" alt="Chef Juan Felipe Camacho" class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute bottom-4 left-4 bg-stone-950/80 backdrop-blur-sm border border-gold-500/20 px-4 py-2">
                            <p class="text-xs font-serif text-gold-400">Juan Felipe Camacho — <span class="italic text-stone-300">Chef & Founder</span></p>
                        </div>
                    </div>
                </div>

                <!-- Col 2: Narrative Text -->
                <div class="lg:col-span-6 flex flex-col gap-8 lg:pl-6">
                    <p class="text-stone-400 text-xs uppercase tracking-widest font-sans">Since 2009</p>
                    <h3 class="text-2xl md:text-4xl font-serif text-gold-400 font-light leading-tight">An honest tribute to local producers and artisanal fishing</h3>
                    
                    <div class="h-[1px] w-full bg-gradient-to-r from-gold-500/30 to-transparent"></div>
                    
                    <div class="flex flex-col gap-6 text-stone-300 font-light leading-relaxed text-sm md:text-base">
                        <p>
                            Donjuán is the result of years of passion of <strong class="text-white font-medium">Juan Felipe Camacho</strong>. Since his arrival in Cartagena in 2005, he dedicated himself to exploring the Caribbean to seek out artisanal fishermen, alternative crops, and small local producers to complete his gastronomic concept.
                        </p>
                        <p>
                            Our cuisine stands out for its absolute respect for the product. The freshest fish and seafood from the Caribbean coast, selected Colombian meats, and our country's incomparable variety of vegetables merge to create casual yet sophisticated dishes, achieving simple yet memorable combinations.
                        </p>
                        <p>
                            After a two-year hiatus, we reopen our doors in the heart of the "walled city," in a beautifully restored historic mansion to continue writing the modern history of Cartagena through flavor.
                        </p>
                    </div>

                    <!-- Quote Block -->
                    <div class="border-l-2 border-gold-500 pl-6 py-2 my-2 italic text-stone-400 font-serif text-lg leading-relaxed">
                        "We seek sophistication through the simplicity and freshness of the local ingredient."
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Exquisite Highlight Menu -->
    <section id="carta" class="py-12 md:py-20 relative overflow-hidden bg-stone-950 scroll-mt-20 bg-fixed bg-cover bg-center" style="background-image: url('/images/fondo-historia.webp');">
        <div class="absolute inset-0 bg-stone-950/85 z-0"></div>
        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
            <!-- Section Header -->
            <div class="text-center mb-8 md:mb-14">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-500 block mb-3 font-sans">Signature Selection</span>
                <h2 class="text-3xl md:text-5xl font-serif text-white font-light tracking-wide">The Donjuán Menu</h2>
                <p class="text-stone-400 font-sans text-sm mt-4 max-w-xl mx-auto">A representative sample of our most acclaimed culinary creations.</p>
                <div class="w-16 h-[1px] bg-gold-500 mx-auto mt-6"></div>
            </div>

            <!-- Custom Category Tabs -->
            <div class="flex justify-center mb-6 md:mb-12">
                <div class="inline-flex gap-1 md:gap-8 overflow-x-auto pb-2 md:pb-4 max-w-full scrollbar-hide">
                <button data-tab="tab-entradas" id="btn-tab-entradas" class="menu-tab-btn active px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-gold-500 text-gold-400 font-medium whitespace-nowrap transition-all duration-300">
                    Starters
                </button>
                <button data-tab="tab-fuertes" id="btn-tab-fuertes" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Main Courses
                </button>
                <button data-tab="tab-postres" id="btn-tab-postres" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Desserts
                </button>
                <button data-tab="tab-cocteles" id="btn-tab-cocteles" class="menu-tab-btn px-2 md:px-6 py-2 text-[10px] md:text-xs uppercase tracking-widest border-b border-transparent text-stone-400 hover:text-white whitespace-nowrap transition-all duration-300">
                    Cocktails
                </button>
                </div>
            </div>

            <!-- Tab Contents -->
            <div class="relative min-h-[400px] md:min-h-[450px]">
                
                <!-- Category 1: Starters -->
                <div id="tab-entradas" class="menu-category-panel grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-100 scale-100">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/crudo_robalo.webp" alt="Sea bass crudo" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Sea Bass Ceviche</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$61.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">With delicious infused coconut milk, fresh cilantro, and crispy Caribbean toasted corn.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-gold-500/10 text-gold-400 px-2 py-0.5 rounded">Recommended</span>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/tartar-res.webp" alt="Beef Tartar" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Beef Tartar</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$53.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Accompanied by crispy tapioca and a smooth homemade truffle mayonnaise.</p>
                        </div>
                    </div>
                    <!-- Item 3 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors overflow-hidden">
                            <img src="/images/tataki-res.png" alt="Grilled Beef Tataki" class="w-full h-full object-cover" />
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Grilled Beef Tataki</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$49.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Artisanal panela teriyaki, traditional local sour cream, and extra virgin olive oil.</p>
                        </div>
                    </div>
                    <!-- Item 4 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors overflow-hidden">
                            <img src="/images/ensalada-papaya.png" alt="Green Papaya Salad" class="w-full h-full object-cover" />
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Green Papaya Salad</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$51.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Tamarind vinaigrette, toasted peanuts, and crispy noodles. An explosion of freshness.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded">Vegetarian</span>
                        </div>
                    </div>
                </div>

                <!-- Category 2: Fuertes -->
                <div id="tab-fuertes" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/robalo.webp" alt="Grilled Sea Bass" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Grilled Sea Bass</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$82.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Served with a silky lemon risotto, parmesan cheese, and confit tomatoes.</p>
                            <span class="inline-block mt-2 text-[9px] uppercase tracking-widest bg-gold-500/10 text-gold-400 px-2 py-0.5 rounded">Signature Dish</span>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/banner-pulpo.webp" alt="Grilled octopus" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Grilled Octopus</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$89.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">With crispy bacon, confit potatoes, sun-dried tomatoes, and a touch of homemade sour cream.</p>
                        </div>
                    </div>
                    <!-- Item 3 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Ribeye Angus Beef</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$199.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Premium grilled cut, seasoned with ancient mustard and crispy tapioca.</p>
                        </div>
                    </div>
                    <!-- Item 4 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M19 12a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Sea Bass with Cayeye</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$83.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Served over green plantain mash (cayeye), creamy shrimp sauce, and coconut milk.</p>
                        </div>
                    </div>
                </div>

                <!-- Category 3: Desserts -->
                <div id="tab-postres" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/cubos-de-piña.webp" alt="Pineapple cubes" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Rum Pineapple Cubes</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$32.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">With local rum reduction, coconut milk, artisanal coconut ice cream, and sweet local sour cream.</p>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <div class="w-16 sm:w-24 h-16 sm:h-24 bg-stone-900 border border-gold-500/10 flex items-center justify-center text-gold-500 text-xl group-hover:border-gold-500/35 transition-colors">
                            <svg class="w-8 h-8 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
                        </div>
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Apple and Dulce de Leche Tart</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$34.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Served warm, with artisanal Bourbon vanilla ice cream and sprinkled macadamia nuts.</p>
                        </div>
                    </div>
                </div>

                <!-- Category 4: Cocteles -->
                <div id="tab-cocteles" class="menu-category-panel hidden grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 transition-all duration-500 opacity-0 scale-95">
                    <!-- Item 1 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/beso-latino.webp" alt="Beso Latino (Latin Kiss)" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Beso Latino (Latin Kiss)</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$48.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Signature cocktail with premium Ojo de Tigre mezcal, muddled blueberries, natural coconut cream, and lime juice.</p>
                        </div>
                    </div>
                    <!-- Item 2 -->
                    <div class="flex flex-row gap-3 sm:gap-4 items-start sm:items-center p-3 sm:p-4 bg-stone-925 border border-gold-500/5 hover:border-gold-500/20 transition-all duration-300 group">
                        <img src="/images/Don-Juan-Restaurant-Cocteles.webp" alt="Signature cocktails" class="w-16 sm:w-24 h-16 sm:h-24 object-cover border border-gold-500/10 group-hover:border-gold-500/35 transition-colors" />
                        <div class="flex-1 text-left">
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="font-serif text-lg text-white group-hover:text-gold-400 transition-colors">Corozo Cosmopolitan</h4>
                                <span class="font-sans text-gold-400 text-sm font-semibold">$44.000</span>
                            </div>
                            <p class="text-stone-400 text-xs font-light leading-relaxed">Caribbean version of the classic Cosmopolitan with Vodka, Cointreau, corozo reduction, and lime.</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- More Menu Button -->
            <div class="text-center mt-6 md:mt-10">
                <a href="/en/menu" class="inline-flex items-center gap-3 px-8 py-4 border border-gold-500 text-gold-400 hover:bg-gold-500 hover:text-stone-950 font-sans text-xs uppercase tracking-widest font-medium transition-all duration-300">
                    See Full Menu <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="galeria" class="py-24 md:py-32 bg-stone-925 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <!-- Section Header -->
            <div class="text-center mb-16 md:mb-24">
                <span class="text-xs uppercase tracking-[0.3em] text-gold-500 block mb-3 font-sans">Donjuán Moments</span>
                <h2 class="text-3xl md:text-5xl font-serif text-white font-light tracking-wide">Atmosphere, Cuisine & Service</h2>
                <div class="w-16 h-[1px] bg-gold-500 mx-auto mt-6"></div>
            </div>

            <!-- Mobile auto-accordion -->
            <div class="gallery-auto-accordion flex flex-col md:hidden">
                <!-- Img 0 -->
