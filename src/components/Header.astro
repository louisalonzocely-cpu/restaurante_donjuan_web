---
export interface Props {
  lang?: 'es' | 'en';
  currentPage?: 'index' | 'menu';
}

const { lang = 'es', currentPage = 'index' } = Astro.props;

const t = {
  es: {
    home: 'Inicio',
    donjuan: 'DonJuan',
    menu: 'Menú',
    gallery: 'Galería',
    events: 'Eventos',
    location: 'Ubicación',
    contact: 'Contacto',
    reserve: 'Reservar Mesa',
  },
  en: {
    home: 'Home',
    donjuan: 'DonJuan',
    menu: 'Menu',
    gallery: 'Gallery',
    events: 'Events',
    location: 'Location',
    contact: 'Contact',
    reserve: 'Book a Table',
  }
}[lang];

const prefix = lang === 'en' ? '/en' : '';
const otherPrefix = lang === 'en' ? '' : '/en';
const otherLang = lang === 'en' ? 'es' : 'en';
const isIndex = currentPage === 'index';
const hasTransparentHeader = currentPage === 'index' || currentPage === 'menu';

const navLinks = [
  { href: `${prefix}/#${isIndex ? 'inicio' : 'inicio'}`, label: t.home },
  { href: `${prefix}/#historia`, label: t.donjuan },
  { href: `${prefix}${isIndex ? '/#carta' : '/menu'}`, label: t.menu, isMenu: true },
  { href: `${prefix}/#galeria`, label: t.gallery },
  { href: `${prefix}/#eventos`, label: t.events },
  { href: `${prefix}/#ubicacion`, label: t.location },
  { href: `${prefix}/#contacto`, label: t.contact },
];
const ctaHref = `${prefix}/#reservas`;
const menuPath = `${prefix}/menu`;
const otherMenuPath = `${otherPrefix}/menu`;
const otherHomePath = otherPrefix || '/';
---

<header
  id="main-header"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500
    {hasTransparentHeader ? 'bg-transparent py-6 text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]' : 'bg-stone-950/90 backdrop-blur-md py-4 border-b border-gold-500/10 text-white'"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
    <a href={prefix || '/'} class="flex items-center gap-3 group relative">
      <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-gold-400 via-amber-300 to-gold-500 opacity-40 animate-pulse blur-[2px]"></div>
      <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-gold-500 via-amber-400 to-gold-500 opacity-0 group-hover:opacity-70 transition-opacity duration-500 blur-[3px]"></div>
      <div class="relative bg-white/80 backdrop-blur-sm p-0 rounded-full overflow-hidden">
        <img loading="lazy" src="/images/logo.webp" alt="Donjuán Logo" width="56" height="56" class="h-12 md:h-14 w-auto transition-transform duration-500 group-hover:scale-105" />
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-8 font-sans text-xs uppercase tracking-widest text-inherit">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`
            transition-colors py-2
            ${link.isMenu && currentPage === 'menu' ? 'text-gold-400 font-semibold border-b border-gold-500' : ''}
            ${link.isMenu && currentPage !== 'menu' ? '' : ''}
            ${!link.isMenu && isIndex ? 'hover:text-gold-400 relative after:content-[\'\'] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-gold-500 hover:after:w-full after:transition-all' : ''}
            ${!link.isMenu && !isIndex ? 'hover:text-gold-400' : ''}
            ${!link.isMenu ? 'hover:text-gold-400' : ''}
          `}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-6">
      <a
        href={ctaHref}
        class="px-6 py-3 border border-gold-500/55 hover:border-gold-400 bg-gold-500/10 hover:bg-gold-500 text-gold-400 hover:text-stone-950 font-sans text-xs uppercase tracking-widest rounded-none transition-all duration-350"
      >
        {t.reserve}
      </a>
      <div class="text-xs uppercase tracking-widest text-inherit flex items-center gap-2">
        {lang === 'es' ? (
          <span class="text-gold-400 font-semibold">ES</span>
        ) : (
          <a href={otherHomePath} class="hover:text-gold-400 transition-colors">ES</a>
        )}
        <span class="text-stone-600">|</span>
        {lang === 'en' ? (
          <span class="text-gold-400 font-semibold">EN</span>
        ) : (
          <a href={otherHomePath} class="hover:text-gold-400 transition-colors">EN</a>
        )}
      </div>
    </div>

    <button id="mobile-menu-btn" class="lg:hidden text-inherit hover:text-gold-400 transition-colors p-2" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h12m-12 6h16" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 bg-stone-950/95 backdrop-blur-md transform translate-x-full transition-transform duration-500 flex flex-col justify-between p-8 lg:hidden"
>
  <div class="flex items-center justify-between">
    <div class="bg-white/80 backdrop-blur-sm p-0 rounded-full overflow-hidden inline-flex">
      <img loading="lazy" src="/images/logo.webp" alt="Donjuán" width="40" height="40" class="h-10 w-auto" />
    </div>
    <button id="close-drawer-btn" class="text-stone-300 hover:text-gold-400 transition-colors p-2">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-6 text-xl uppercase tracking-widest font-serif text-center my-auto">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`mobile-nav-link transition-colors py-2 ${
          link.isMenu && currentPage === 'menu' ? 'text-gold-400' : 'text-stone-200 hover:text-gold-400'
        }`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="flex flex-col gap-4 text-center">
    <a
      href={ctaHref}
      class="mobile-nav-link w-full py-4 bg-gold-500 text-stone-950 font-sans text-xs uppercase tracking-widest font-bold"
    >
      {t.reserve}
    </a>
    <div class="text-xs uppercase tracking-widest text-stone-400 flex items-center justify-center gap-4 py-2">
      {lang === 'es' ? (
        <span class="text-gold-400 font-semibold">ES</span>
      ) : (
        <a href={otherHomePath} class="hover:text-white transition-colors">ES</a>
      )}
      <span class="text-stone-700">|</span>
      {lang === 'en' ? (
        <span class="text-gold-400 font-semibold">EN</span>
      ) : (
        <a href={otherHomePath} class="hover:text-white transition-colors">EN</a>
      )}
    </div>
  </div>
</div>
